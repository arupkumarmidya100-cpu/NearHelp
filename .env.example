# ─────────────────────────────────────────────────────────
# NearHelp — Environment Variables Example
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# MongoDB
# Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/nearhelp
MONGO_URI=mongodb://127.0.0.1:27017/nearhelp

# Authentication is handled by Firebase Admin SDK.

# AI Service — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Firebase — paste the entire firebase-service-account.json as a single-line JSON string
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# ⚠️  CRITICAL: Never commit the raw .json file. Use this env var instead.
FIREBASE_SERVICE_ACCOUNT=

# Frontend origin (used for CORS and Socket.io)
CLIENT_URL=http://localhost:3000

# Emergency default contact number
EMERGENCY_CONTACT_NUMBER=112

# Optional — default location fallback (lat/lng)
LAT=20.5937
LNG=78.9629

# ─────────────────────────────────────────────────────────
# Android / Google Play (no env vars needed — see below)
# ─────────────────────────────────────────────────────────
# App ID  : com.w3bix.nearhelp
# Build   : cd frontend && npm run build && npx cap sync android
# Open    : npx cap open android  (requires Android Studio)
# Release : Build > Generate Signed Bundle/APK in Android Studio
